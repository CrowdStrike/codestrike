# Codestrike Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# GitHub
# =============================================================================

# Personal access token with `repo` scope
GITHUB_TOKEN=ghp_your-github-token-here

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Which LLM provider to use: openai_platform, anthropic, ollama
MODEL_FAMILY=openai_platform

# Model ID to use (e.g., gpt-4o, claude-sonnet-4-20250514, llama3)
MODEL_ID=gpt-4o

# --- OpenAI Platform ---
OPEN_AI_BASE_URL=https://api.openai.com/v1
OPEN_AI_KEY=sk-proj-your-openai-api-key-here

# --- AWS Bedrock (for Anthropic/Claude models) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# --- Ollama (local models) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Application Settings
# =============================================================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
